---
import CategoryPills from './CategoryPills.astro';

interface Props {
  title: string;
  summary: string;
  categories: string[];
  href: string;
  image?: string;
  imageAlt?: string;
  funder?: string;
}

const { title, summary, categories, href, image, imageAlt, funder } = Astro.props;
---

<a
  href={href}
  class="group flex flex-col overflow-hidden rounded-xl border border-gray-100 bg-white shadow-sm transition hover:shadow-md focus:outline-none focus:ring-2 focus:ring-brand"
>
  {
    image ? (
      <img
        src={image}
        alt={imageAlt ?? title}
        class="aspect-video w-full object-cover"
        loading="lazy"
      />
    ) : (
      <div class="flex aspect-video w-full items-center justify-center bg-brand-light px-6 text-center text-brand-dark">
        <CategoryPills categories={categories} size="md" class="justify-center" />
      </div>
    )
  }
  <div class="flex flex-1 flex-col p-4">
    <CategoryPills categories={categories} />
    {
      funder && (
        <p class="mt-2 text-xs font-semibold uppercase tracking-wide text-brand-dark">
          Funded by {funder}
        </p>
      )
    }
    <h3 class="mt-2 font-heading text-lg font-bold text-brand-dark group-hover:text-brand">
      {title}
    </h3>
    <p class="mt-2 line-clamp-3 text-sm text-muted">{summary}</p>
    <span class="mt-3 text-sm font-medium text-brand">Read more →</span>
  </div>
</a>
