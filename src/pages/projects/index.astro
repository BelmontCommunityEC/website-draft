---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { resolveCategories } from '../../content/categories';
import { primaryFunderName } from '../../content/organisations';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title="Projects"
  description="Explore BCEC community projects — litter clean-ups, tree planting and local environmental action."
>
  <section class="mx-auto max-w-6xl px-4 py-12">
    <h1 class="font-heading text-3xl font-bold text-brand-dark sm:text-4xl">Our projects</h1>
    <p class="mt-3 max-w-2xl text-muted">
      A record of the community work we've delivered together — from tree planting to
      neighbourhood clean-ups.
    </p>

    {
      projects.length > 0 ? (
        <div class="mt-8 grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
          {projects.map((project) => (
            <ProjectCard
              title={project.data.title}
              summary={project.data.summary}
              categories={resolveCategories(project.data)}
              image={project.data.image}
              imageAlt={project.data.imageAlt}
              funder={primaryFunderName(project.data.partners)}
              href={`/projects/${project.id}`}
            />
          ))}
        </div>
      ) : (
        <p class="mt-8 text-muted">No projects published yet — check back soon.</p>
      )
    }
  </section>
</BaseLayout>
