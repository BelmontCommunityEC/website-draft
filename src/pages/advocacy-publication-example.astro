---
import BaseLayout from '../layouts/BaseLayout.astro';

const publicationChecklist = [
  'Committee-approved final text',
  'Personal and sensitive information removed',
  'Facts and references checked',
  'Clear status label added (Submitted, Superseded, Archived)',
  'Summary written in plain language',
];

const sampleItems = [
  {
    title: 'Urban Forest Best Practice Benchmark',
    type: 'Position Statement',
    date: '15 July 2026',
    recipient: 'City of Belmont',
    status: 'Submitted',
    summary:
      'BCEC recommends stronger canopy targets, design standards that protect mature trees, and measurable post-development tree survival outcomes.',
    asks: [
      'Adopt a higher canopy target for new developments.',
      'Require tree-protection plans during construction.',
      'Report annually on canopy retention and replacement outcomes.',
    ],
  },
  {
    title: 'Community Feedback on Foreshore Management',
    type: 'Consultation Submission',
    date: '02 June 2026',
    recipient: 'City of Belmont',
    status: 'Under Review',
    summary:
      'BCEC feedback supports improved habitat protection, safer active transport links, and staged restoration priorities for high-impact zones.',
    asks: [
      'Prioritise erosion hotspots for immediate action.',
      'Strengthen habitat corridors in planting plans.',
      'Publish a clear implementation timeline with milestones.',
    ],
  },
];
---

<BaseLayout
  title="Advocacy Publication Example"
  description="Example page for publishing BCEC position statements and community consultation feedback."
>
  <section class="bg-brand-light/50">
    <div class="mx-auto max-w-5xl px-4 py-12 sm:py-16">
      <p class="inline-flex rounded-full bg-brand-dark px-3 py-1 text-xs font-semibold uppercase tracking-wide text-white">
        Committee Draft Example
      </p>
      <h1 class="mt-4 font-heading text-3xl font-bold text-brand-dark sm:text-4xl">
        Advocacy and Consultation Library
      </h1>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-muted sm:text-lg">
        This is an example page layout BCEC could use to publish position statements and
        community consultation feedback in a clear, consistent and transparent way.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-10 sm:py-12">
    <div class="rounded-2xl border border-brand-light bg-white p-5 shadow-sm sm:p-6">
      <h2 class="font-heading text-xl font-bold text-brand-dark sm:text-2xl">Publication Checklist</h2>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2">
        {
          publicationChecklist.map((item) => (
            <li class="rounded-lg border border-gray-100 bg-surface p-3 text-sm text-ink">{item}</li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-12">
    <h2 class="font-heading text-xl font-bold text-brand-dark sm:text-2xl">Sample Published Items</h2>
    <div class="mt-6 grid gap-4">
      {
        sampleItems.map((item) => (
          <article class="rounded-2xl border border-brand-light bg-white p-5 shadow-sm sm:p-6">
            <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
              <div>
                <h3 class="font-heading text-lg font-bold text-brand-dark sm:text-xl">{item.title}</h3>
                <p class="mt-1 text-sm text-muted">{item.type}</p>
              </div>
              <p class="inline-flex w-fit rounded-full bg-brand px-3 py-1 text-xs font-semibold uppercase tracking-wide text-white">
                {item.status}
              </p>
            </div>

            <dl class="mt-4 grid gap-2 text-sm text-ink sm:grid-cols-3">
              <div>
                <dt class="font-semibold text-brand-dark">Date</dt>
                <dd>{item.date}</dd>
              </div>
              <div>
                <dt class="font-semibold text-brand-dark">Recipient</dt>
                <dd>{item.recipient}</dd>
              </div>
              <div>
                <dt class="font-semibold text-brand-dark">Document</dt>
                <dd>{item.type}</dd>
              </div>
            </dl>

            <p class="mt-4 text-sm leading-relaxed text-ink sm:text-base">{item.summary}</p>

            <h4 class="mt-5 font-heading text-base font-bold text-brand-dark">What BCEC asked for</h4>
            <ul class="mt-2 list-disc space-y-1 pl-5 text-sm leading-relaxed text-ink sm:text-base">
              {item.asks.map((ask) => <li>{ask}</li>)}
            </ul>

            <div class="mt-5 flex flex-col gap-2 sm:flex-row">
              <a href="#" class="rounded-lg bg-brand px-4 py-2 text-center text-sm font-semibold text-white transition hover:bg-brand-dark">
                View full document (PDF)
              </a>
              <a href="#" class="rounded-lg border border-brand px-4 py-2 text-center text-sm font-semibold text-brand transition hover:bg-brand-light">
                View timeline and updates
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-4 pb-14">
      <div class="rounded-2xl border border-brand-light bg-brand-light/40 p-5 sm:p-6">
        <h2 class="font-heading text-xl font-bold text-brand-dark sm:text-2xl">Committee Note</h2>
        <p class="mt-3 text-sm leading-relaxed text-ink sm:text-base">
          This page is a discussion mock-up only. It shows a structure BCEC could use if the
          committee decides to publish advocacy documents by default with privacy and governance checks.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
